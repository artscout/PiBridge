# SPDX-License-Identifier: MIT
# libpibridge-ctrl, tracker half (M7): the LED constellation tracker of the Pimax controllers (blobs, LED models, P3P,
# joint solve, assignment, the tracker, the pose file), ported from omarchyvr pimax-ctrltrack (MIT OR Apache-2.0).
# Namespace pibridge::ctrl::track, targets pibridge_ctrltrack_obj / pibridge_ctrltrack; the tool is tools/ctrltrack.
# Included from libpibridge-ctrl/CMakeLists.txt; needs libpibridge-cam.

# The Dream Air reference controller LED models and the camera extrinsics refit of the reference headset
# (devices/dream-air/reference/, no serials), embedded like the Rust include_str!.
set(pibridge_ctrl_ref_dir "${PIBRIDGE_SOURCE_DEVICES_DIR}/dream-air/reference")
set(pibridge_ctrl_ref_files "${pibridge_ctrl_ref_dir}/controllers/left.json" "${pibridge_ctrl_ref_dir}/controllers/right.json"
    "${pibridge_ctrl_ref_dir}/ctrl-cam-extrinsics.json")
function(pibridge_ctrltrack_bytes file out_var len_var)
    file(READ "${file}" hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(LENGTH "${hex}" n)
    math(EXPR n "${n} / 2")
    set(${out_var} "${bytes}" PARENT_SCOPE)
    set(${len_var} "${n}" PARENT_SCOPE)
endfunction()
pibridge_ctrltrack_bytes("${pibridge_ctrl_ref_dir}/controllers/left.json" left_bytes left_len)
pibridge_ctrltrack_bytes("${pibridge_ctrl_ref_dir}/controllers/right.json" right_bytes right_len)
pibridge_ctrltrack_bytes("${pibridge_ctrl_ref_dir}/ctrl-cam-extrinsics.json" ext_bytes ext_len)
file(CONFIGURE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/track_reference.cpp" CONTENT
"// SPDX-License-Identifier: MIT
// Generated by libpibridge-ctrl/track.cmake from devices/dream-air/reference/controllers/{left,right}.json and
// devices/dream-air/reference/ctrl-cam-extrinsics.json.
#include \"pibridge/ctrl/track/extrinsics.h\"
#include \"pibridge/ctrl/track/model.h\"
namespace pibridge::ctrl::track {
namespace {
const char k_left[] = {@left_bytes@ 0};
const char k_right[] = {@right_bytes@ 0};
const char k_ext[] = {@ext_bytes@ 0};
}
std::string_view reference_left() { return std::string_view(k_left, @left_len@); }
std::string_view reference_right() { return std::string_view(k_right, @right_len@); }
std::string_view extrinsics::reference_json() { return std::string_view(k_ext, @ext_len@); }
}
" @ONLY)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${pibridge_ctrl_ref_files})

find_package(Threads REQUIRED)
add_library(pibridge_ctrltrack_obj OBJECT
    src/track/blob.cpp
    src/track/assign.cpp
    src/track/p3p.cpp
    src/track/model.cpp
    src/track/extrinsics.cpp
    src/track/solve.cpp
    src/track/shm.cpp
    src/track/rig.cpp
    src/track/tracker.cpp
    src/track/imutrack.cpp
    ${CMAKE_CURRENT_BINARY_DIR}/track_reference.cpp
)
target_include_directories(pibridge_ctrltrack_obj PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/include)
target_include_directories(pibridge_ctrltrack_obj PUBLIC $<TARGET_PROPERTY:pibridge_cam_obj,INTERFACE_INCLUDE_DIRECTORIES>)
target_compile_features(pibridge_ctrltrack_obj PUBLIC cxx_std_23)
target_compile_options(pibridge_ctrltrack_obj PRIVATE ${PIBRIDGE_CAM_PARITY_FLAGS})

add_library(pibridge_ctrltrack STATIC $<TARGET_OBJECTS:pibridge_ctrltrack_obj>)
target_include_directories(pibridge_ctrltrack PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/include)
target_compile_features(pibridge_ctrltrack PUBLIC cxx_std_23)
target_link_libraries(pibridge_ctrltrack PUBLIC pibridge_cam Threads::Threads)

if(PIBRIDGE_BUILD_TESTS)
    # Twins of the Rust #[test]s of pimax-ctrltrack's library modules and the binary's tracker.rs.
    foreach(t blob assign p3p model extrinsics solve shm tracker improved)
        add_executable(pibridge_ctrltrack_test_${t} tests/track/test_${t}.cpp)
        target_link_libraries(pibridge_ctrltrack_test_${t} PRIVATE pibridge_ctrltrack pibridge_common)
        target_compile_options(pibridge_ctrltrack_test_${t} PRIVATE -ffp-contract=off)
        add_test(NAME pibridge_ctrltrack_${t} COMMAND pibridge_ctrltrack_test_${t})
        set_tests_properties(pibridge_ctrltrack_${t} PROPERTIES SKIP_RETURN_CODE 77
            ENVIRONMENT "TMPDIR=${CMAKE_CURRENT_BINARY_DIR}")
    endforeach()
endif()
