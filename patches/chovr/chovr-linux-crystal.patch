+
+void PimaxSlamDriver::StopPvrTracking() {
+	if (pvrTrackingRunning.exchange(false) && pvrTrackingThread.joinable()) {
+		DriverLog("Stopping the Pimax Crystal tracking thread");
+		pvrTrackingThread.join();
+		pvrTrackingThread = {};
+	}
+}
+
+void PimaxSlamDriver::PvrTrackingThread() {
+	// 500 Hz, as the Windows driver; the headset reports its pose about 667 times a second
+	timespec next{};
+	clock_gettime(CLOCK_MONOTONIC, &next);
+	while (pvrTrackingRunning) {
+		next.tv_nsec += 2000000;
+		if (next.tv_nsec >= 1000000000) {
+			next.tv_nsec -= 1000000000;
+			next.tv_sec++;
+		}
+		clock_nanosleep(CLOCK_MONOTONIC, TIMER_ABSTIME, &next, nullptr);
+		if (deviceIndex < 0) {
+			continue;
+		}
+		const int64_t now = SharedMemoryPose::NowNs();
+		const auto snapshot = SharedMemoryPose::Read();
+		const bool fresh = snapshot && now - snapshot->writtenNs < k_StaleNs;
+		SharedMemoryPose::Device head;
+		if (snapshot) {
+			head = snapshot->devices[0];
+		}
+		// flags of its inside-out: 1 orientation, 2 position (orientation only: just started, or it cannot see the room)
+		const uint32_t flags = snapshot ? snapshot->tracking : 0;
+		const bool headTracked = fresh && head.state == 1 && (flags & 1) != 0;
+		vr::DriverPose_t pose = PoseFromDevice(head, now, headTracked, headTracked && (flags & 2) != 0);
+		vr::VRServerDriverHost()->TrackedDevicePoseUpdated(deviceIndex, pose, sizeof(pose));
+
+		std::shared_lock lock(s_controllerDriverMutex);
+		for (int side = 0; side < 2; side++) {
+			if (s_controllerDriver[side] && snapshot) {
+				s_controllerDriver[side]->UpdateTrackingState(snapshot->devices[1 + side], now, fresh);
+				if (fresh) {
+					s_controllerDriver[side]->UpdateInputs(snapshot->devices[1 + side], now);
+				}
+			}
+		}
+	}
+}
+
 #endif // PVR_EXISTS
