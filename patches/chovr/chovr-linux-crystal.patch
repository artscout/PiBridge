+// The original Pimax Crystal tracks itself (inside-out on the headset); PiBridge's pibridge-keepalived reads the poses
+// it streams over its HID and writes them to shared memory (SharedMemoryPoseSource.h). This is the Windows driver's
+// SLAM headset with that file in place of pvr_getTrackingState / pvr_getInputState: the head, and the Crystal
+// controllers as Touch controllers (pose, buttons, touches, trigger, grip, stick). Not yet: haptics, the passthrough
+// camera, hand tracking.
+
+#include "../Helpers/EyeTrackingOutput.h"
+#include "../Helpers/SharedMemoryEyeSource.h"
+#include "../Helpers/SharedMemoryPoseSource.h"
+#include "../Helpers/MiscHelper.h"
+
+#include <cstring>
+#include <memory>
+#include <shared_mutex>
+#include <time.h>
+
+// Matches the Windows driver (driver_aapvr).
+static constexpr uint64_t k_UniverseId = 30;
+// The file is older than this: the headset or its writer is gone.
+static constexpr int64_t k_StaleNs = 500000000;
+
+static vr::DriverPose_t PoseFromDevice(const SharedMemoryPose::Device& d, int64_t nowNs, bool tracked, bool positionTracked) {
+	vr::DriverPose_t pose = {};
+	pose.qWorldFromDriverRotation.w = pose.qDriverFromHeadRotation.w = pose.qRotation.w = 1.0;
+	pose.deviceIsConnected = true;
+	pose.result = vr::TrackingResult_Running_OutOfRange;
+	if (tracked) {
+		for (int i = 0; i < 3; i++) {
+			pose.vecPosition[i] = d.position[i];
+			pose.vecVelocity[i] = positionTracked ? d.linearVelocity[i] : 0;
+			pose.vecAngularVelocity[i] = d.angularVelocity[i];
+		}
+		pose.qRotation.x = d.orientation[0];
+		pose.qRotation.y = d.orientation[1];
+		pose.qRotation.z = d.orientation[2];
+		pose.qRotation.w = d.orientation[3];
+		// how old the sample is (negative); kept within 100 ms so a clock error never sends SteamVR a pose from the
+		// distant past (it fades the headset to black then)
+		const double offset = double(d.timeNs - nowNs) / 1e9;
+		pose.poseTimeOffset = offset < -0.1 ? -0.1 : offset > 0 ? 0 : offset;
+		pose.poseIsValid = true;
+		pose.result = positionTracked ? vr::TrackingResult_Running_OK : vr::TrackingResult_Fallback_RotationOnly;
+	}
+	return pose;
+}
