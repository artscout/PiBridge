+// A Pimax Crystal controller, presented as an Oculus Touch controller (as the Windows driver does).
+class PimaxCrystalControllerDriver : public vr::ITrackedDeviceServerDriver {
+public:
+	PimaxCrystalControllerDriver(vr::ETrackedControllerRole role) : role(role) {
+	}
+
+	vr::EVRInitError Activate(uint32_t unObjectId) override {
+		deviceIndex = unObjectId;
+		const bool isLeft = role == vr::TrackedControllerRole_LeftHand;
+		const vr::PropertyContainerHandle_t container = vr::VRProperties()->TrackedDeviceToPropertyContainer(deviceIndex);
+
+		vr::VRProperties()->SetInt32Property(container, vr::Prop_ControllerRoleHint_Int32, role);
+		vr::VRProperties()->SetStringProperty(container, vr::Prop_TrackingSystemName_String, "oculus");
+		vr::VRProperties()->SetStringProperty(container, vr::Prop_ManufacturerName_String, "Oculus");
+		vr::VRProperties()->SetStringProperty(
+			container, vr::Prop_ModelNumber_String, isLeft ? "Oculus Quest2 (Left Controller)" : "Oculus Quest2 (Right Controller)");
+		vr::VRProperties()->SetStringProperty(container, vr::Prop_InputProfilePath_String, "{oculus}/input/touch_profile.json");
+		vr::VRProperties()->SetStringProperty(container, vr::Prop_ControllerType_String, "oculus_touch");
+		// SteamVR's own model (the Crystal controller models are in Pimax's Windows driver)
+		vr::VRProperties()->SetStringProperty(
+			container, vr::Prop_RenderModelName_String, isLeft ? "oculus_quest2_controller_left" : "oculus_quest2_controller_right");
+		vr::VRProperties()->SetUint64Property(container, vr::Prop_CurrentUniverseId_Uint64, k_UniverseId);
+		vr::VRProperties()->SetBoolProperty(container, vr::Prop_DeviceProvidesBatteryStatus_Bool, true);
+
+		vr::VRDriverInput()->CreateScalarComponent(container, "/input/trigger/value", &components[ComponentTrigger],
+			vr::VRScalarType_Absolute, vr::VRScalarUnits_NormalizedOneSided);
+		vr::VRDriverInput()->CreateBooleanComponent(container, "/input/trigger/click", &components[ComponentTriggerClick]);
+		vr::VRDriverInput()->CreateBooleanComponent(container, "/input/trigger/touch", &components[ComponentTriggerTouch]);
+		vr::VRDriverInput()->CreateScalarComponent(container, "/input/grip/value", &components[ComponentGrip],
+			vr::VRScalarType_Absolute, vr::VRScalarUnits_NormalizedOneSided);
+		vr::VRDriverInput()->CreateBooleanComponent(container, "/input/grip/click", &components[ComponentGripClick]);
+		vr::VRDriverInput()->CreateScalarComponent(container, "/input/joystick/x", &components[ComponentThumbstickX],
+			vr::VRScalarType_Absolute, vr::VRScalarUnits_NormalizedTwoSided);
+		vr::VRDriverInput()->CreateScalarComponent(container, "/input/joystick/y", &components[ComponentThumbstickY],
+			vr::VRScalarType_Absolute, vr::VRScalarUnits_NormalizedTwoSided);
+		vr::VRDriverInput()->CreateBooleanComponent(container, "/input/joystick/click", &components[ComponentThumbstickClick]);
+		vr::VRDriverInput()->CreateBooleanComponent(container, "/input/joystick/touch", &components[ComponentThumbstickTouch]);
+		vr::VRDriverInput()->CreateBooleanComponent(container, "/input/system/click", &components[ComponentMenu]);
+		vr::VRDriverInput()->CreateBooleanComponent(container, isLeft ? "/input/y/click" : "/input/b/click", &components[ComponentButton1]);
+		vr::VRDriverInput()->CreateBooleanComponent(container, isLeft ? "/input/y/touch" : "/input/b/touch", &components[ComponentButton1Touch]);
+		vr::VRDriverInput()->CreateBooleanComponent(container, isLeft ? "/input/x/click" : "/input/a/click", &components[ComponentButton2]);
+		vr::VRDriverInput()->CreateBooleanComponent(container, isLeft ? "/input/x/touch" : "/input/a/touch", &components[ComponentButton2Touch]);
+		vr::VRInputComponentHandle_t haptics;
+		vr::VRDriverInput()->CreateHapticComponent(container, "/output/haptic", &haptics);
+		return vr::VRInitError_None;
+	}
+
+	void Deactivate() override {
+		deviceIndex = vr::k_unTrackedDeviceIndexInvalid;
+	}
+	void EnterStandby() override {
+	}
+	void* GetComponent(const char* pchComponentNameAndVersion) override {
+		return nullptr;
+	}
+	vr::DriverPose_t GetPose() override {
+		return {};
+	}
+	void DebugRequest(const char* pchRequest, char* pchResponseBuffer, uint32_t unResponseBufferSize) override {
+		if (unResponseBufferSize >= 1) {
+			pchResponseBuffer[0] = 0;
+		}
+	}
+
+	// From the tracking thread. State 7: optically tracked; 5: the IMU only (orientation, the position frozen); else no pose.
+	void UpdateTrackingState(const SharedMemoryPose::Device& d, int64_t nowNs, bool fresh) {
+		if (deviceIndex == vr::k_unTrackedDeviceIndexInvalid) {
+			return;
+		}
+		const bool tracked = fresh && (d.state == 7 || d.state == 5);
+		vr::DriverPose_t pose = PoseFromDevice(d, nowNs, tracked, d.state == 7);
+		pose.deviceIsConnected = fresh && d.state != 0;
+		// The headset reports the controller's tip; SteamVR wants the origin of the render model. As the Windows driver
+		// does with the Crystal controller model: the inverse of its "tip" component (origin (0, -0.019, 0.014),
+		// rotate_xyz (-35.65, 0, 0)), i.e. a turn of +35.65 degrees about x and (0, 0.0236, -0.0003) m. The Quest 2 model
+		// shown has nearly the same tip (-37.4 degrees) and the same openxr_aim.
+		pose.qDriverFromHeadRotation.x = 0.306111;
+		pose.qDriverFromHeadRotation.y = 0;
+		pose.qDriverFromHeadRotation.z = 0;
+		pose.qDriverFromHeadRotation.w = 0.951996;
+		pose.vecDriverFromHeadTranslation[0] = 0;
+		pose.vecDriverFromHeadTranslation[1] = 0.023599;
+		pose.vecDriverFromHeadTranslation[2] = -0.000302;
+		vr::VRServerDriverHost()->TrackedDevicePoseUpdated(deviceIndex, pose, sizeof(pose));
+	}
+
+	// From the tracking thread, when something changed. The headset's controller report (PiBridge's p3b.h): pressed
+	// 0x01 A/X, 0x02 B/Y, 0x04 menu, 0x08 stick, 0x40 Pimax; touched (<< 8) 0x01 A/X, 0x02 B/Y, 0x08 stick,
+	// 0x10 trigger, 0x20 grip; axes trigger, grip, stick x, stick y.
+	void UpdateInputs(const SharedMemoryPose::Device& d, int64_t nowNs) {
+		if (deviceIndex == vr::k_unTrackedDeviceIndexInvalid || (d.buttons == lastButtons && memcmp(d.axes, lastAxes, sizeof lastAxes) == 0)) {
+			return;
+		}
+		lastButtons = d.buttons;
+		memcpy(lastAxes, d.axes, sizeof lastAxes);
+		const double t = double(d.timeNs - nowNs) / 1e9;
+		const uint32_t pressed = d.buttons & 0xff, touched = (d.buttons >> 8) & 0xff;
+		auto& in = *vr::VRDriverInput();
+		in.UpdateScalarComponent(components[ComponentTrigger], d.axes[0], t);
+		in.UpdateBooleanComponent(components[ComponentTriggerClick], d.axes[0] >= 0.9f, t); // no click bit: by the value
+		in.UpdateBooleanComponent(components[ComponentTriggerTouch], (touched & 0x10) != 0, t);
+		in.UpdateScalarComponent(components[ComponentGrip], d.axes[1], t);
+		in.UpdateBooleanComponent(components[ComponentGripClick], d.axes[1] >= 0.9f, t);
+		in.UpdateScalarComponent(components[ComponentThumbstickX], d.axes[2], t);
+		in.UpdateScalarComponent(components[ComponentThumbstickY], d.axes[3], t);
+		in.UpdateBooleanComponent(components[ComponentThumbstickClick], (pressed & 0x08) != 0, t);
+		in.UpdateBooleanComponent(components[ComponentThumbstickTouch], (touched & 0x08) != 0, t);
+		in.UpdateBooleanComponent(components[ComponentButton1], (pressed & 0x02) != 0, t);
+		in.UpdateBooleanComponent(components[ComponentButton1Touch], (touched & 0x02) != 0, t);
+		in.UpdateBooleanComponent(components[ComponentButton2], (pressed & 0x01) != 0, t);
+		in.UpdateBooleanComponent(components[ComponentButton2Touch], (touched & 0x01) != 0, t);
+		// the Pimax button and the menu button: SteamVR's system button (its dashboard)
+		in.UpdateBooleanComponent(components[ComponentMenu], (pressed & (0x40 | 0x04)) != 0, t);
+	}
+
+	// From RunFrame.
+	void UpdateBattery(int battery) {
+		if (deviceIndex == vr::k_unTrackedDeviceIndexInvalid || battery < 0 || battery == lastBattery) {
+			return;
+		}
+		lastBattery = battery;
+		const vr::PropertyContainerHandle_t container = vr::VRProperties()->TrackedDeviceToPropertyContainer(deviceIndex);
+		vr::VRProperties()->SetFloatProperty(container, vr::Prop_DeviceBatteryPercentage_Float, battery / 100.f);
+	}
+
+private:
+	enum Components {
+		ComponentTrigger,
+		ComponentTriggerClick,
+		ComponentTriggerTouch,
+		ComponentGrip,
+		ComponentGripClick,
+		ComponentThumbstickX,
+		ComponentThumbstickY,
+		ComponentThumbstickClick,
+		ComponentThumbstickTouch,
+		ComponentButton1,
+		ComponentButton1Touch,
+		ComponentButton2,
+		ComponentButton2Touch,
+		ComponentMenu,
+		ComponentCount,
+	};
+	const vr::ETrackedControllerRole role;
+	vr::TrackedDeviceIndex_t deviceIndex = vr::k_unTrackedDeviceIndexInvalid;
+	vr::VRInputComponentHandle_t components[ComponentCount] = {};
+	int lastBattery = -1;
+	uint32_t lastButtons = 0xffffffff; // the first report is always sent
+	float lastAxes[4] = {};
+};
