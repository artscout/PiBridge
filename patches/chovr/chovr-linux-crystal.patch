diff --git a/CustomHeadsetOpenVR/src/Helpers/SharedMemoryPoseSource.cpp b/CustomHeadsetOpenVR/src/Helpers/SharedMemoryPoseSource.cpp
new file mode 100644
index 0000000..23a8a8c
--- /dev/null
+++ b/CustomHeadsetOpenVR/src/Helpers/SharedMemoryPoseSource.cpp
@@ -0,0 +1,104 @@
+#include "SharedMemoryPoseSource.h"
+
+#ifndef _WIN32
+
+#include <cstdlib>
+#include <cstring>
+#include <fcntl.h>
+#include <string>
+#include <time.h>
+#include <unistd.h>
+
+namespace SharedMemoryPose {
+
+namespace {
+
+constexpr uint32_t kMagic = 0x53504250u; // "PBPS"
+constexpr uint32_t kVersion = 1;
+constexpr size_t kSize = 328;
+constexpr size_t kDevice = 96;
+// older than this, the writer (or the headset) is gone
+constexpr int64_t kStaleNs = 500000000;
+
+template <typename T> T At(const uint8_t* b, size_t offset) {
+	T v;
+	memcpy(&v, b + offset, sizeof(T));
+	return v;
+}
+
+int OpenFile() {
+	const char* env = getenv("CUSTOM_HEADSET_POSE_SHM");
+	const std::string path = env && *env ? env : "/dev/shm/pibridge-crystal-pose";
+	return open(path.c_str(), O_RDONLY | O_CLOEXEC);
+}
+
+} // namespace
+
+int64_t NowNs() {
+	timespec ts{};
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return int64_t(ts.tv_sec) * 1000000000 + ts.tv_nsec;
+}
+
+std::optional<Snapshot> Read() {
+	// opened once per thread and kept: the writer rewrites the same file in place (reopened when a read fails)
+	thread_local int fd = -1;
+	if (fd < 0) {
+		fd = OpenFile();
+		if (fd < 0) {
+			return std::nullopt;
+		}
+	}
+	for (int attempt = 0; attempt < 8; attempt++) {
+		uint8_t b[kSize];
+		// seq_end, body, seq_begin, each with its own pread (the order the writer's pwrites guarantee)
+		if (pread(fd, b + 320, 8, 320) != 8 || pread(fd, b + 8, 312, 8) != 312 || pread(fd, b, 8, 0) != 8) {
+			close(fd);
+			fd = -1;
+			return std::nullopt;
+		}
+		const uint64_t begin = At<uint64_t>(b, 0), end = At<uint64_t>(b, 320);
+		if (begin != end || begin == 0 || (begin & 1)) {
+			continue;
+		}
+		if (At<uint32_t>(b, 8) != kMagic || At<uint32_t>(b, 12) != kVersion) {
+			return std::nullopt;
+		}
+		Snapshot s;
+		s.writtenNs = At<int64_t>(b, 16);
+		s.tracking = At<uint32_t>(b, 24);
+		for (size_t i = 0; i < 3; i++) {
+			const size_t o = 32 + i * kDevice;
+			Device& d = s.devices[i];
+			d.timeNs = At<int64_t>(b, o);
+			d.state = At<uint32_t>(b, o + 8);
+			d.battery = At<int32_t>(b, o + 12);
+			memcpy(d.position, b + o + 16, 12);
+			memcpy(d.orientation, b + o + 28, 16);
+			memcpy(d.linearVelocity, b + o + 44, 12);
+			memcpy(d.angularVelocity, b + o + 56, 12);
+			d.buttons = At<uint32_t>(b, o + 68);
+			memcpy(d.axes, b + o + 72, 16);
+			d.sample = At<uint64_t>(b, o + 88);
+		}
+		return s;
+	}
+	return std::nullopt;
+}
+
+bool HeadsetTracksItself() {
+	const auto s = Read();
+	return s && NowNs() - s->writtenNs < kStaleNs && s->tracking != 0 && s->devices[0].timeNs != 0;
+}
+
+} // namespace SharedMemoryPose
+
+#else
+
+namespace SharedMemoryPose {
+std::optional<Snapshot> Read() { return std::nullopt; }
+int64_t NowNs() { return 0; }
+bool HeadsetTracksItself() { return false; }
+} // namespace SharedMemoryPose
+
+#endif
diff --git a/CustomHeadsetOpenVR/src/Helpers/SharedMemoryPoseSource.h b/CustomHeadsetOpenVR/src/Helpers/SharedMemoryPoseSource.h
new file mode 100644
index 0000000..d18e822
--- /dev/null
+++ b/CustomHeadsetOpenVR/src/Helpers/SharedMemoryPoseSource.h
@@ -0,0 +1,50 @@
+#pragma once
+
+#include <cstdint>
+#include <optional>
+
+// The headset's own inside-out tracking from another process through a small shared memory file, for platforms
+// without the Pimax runtime (Linux): PiBridge's pibridge-keepalived writes what the original Pimax Crystal streams over
+// its HID (head and controllers, tracked by the headset itself).
+//
+// Default file: /dev/shm/pibridge-crystal-pose (environment CUSTOM_HEADSET_POSE_SHM overrides it). The format (328
+// bytes, little endian, the headset's tracking space: y up, metres; CLOCK_MONOTONIC nanoseconds):
+//   0 u64 seq_begin | 8 u32 magic "PBPS" | 12 u32 version 1 | 16 i64 publish time | 24 u32 the headset's own
+//   inside-out, flags 1 orientation 2 position (0: Lighthouse mode) | 28 u32 reserved | 32 three devices (head, left,
+//   right), 96 bytes each:
+//     +0 i64 sample time (0 never) | +8 u32 state (head 1 tracked; controller 4 no pose, 5 IMU only, 7 optical)
+//     +12 i32 battery % | +16 f32[3] position | +28 f32[4] orientation x y z w | +44 f32[3] linear velocity
+//     +56 f32[3] angular velocity (tracking space) | +68 u32 buttons | +72 f32[4] trigger grip stick-x stick-y
+//     +88 u64 sample number
+//   320 u64 seq_end
+// The writer stores an odd seq_begin, the body, the new even value in seq_end, then in seq_begin; a copy is
+// consistent when both are equal and even. PiBridge's side: libpibridge-hmd pibridge/hmd/pose_shm.h.
+namespace SharedMemoryPose {
+
+struct Device {
+	int64_t timeNs = 0;
+	uint32_t state = 0;
+	int32_t battery = -1;
+	float position[3] = {};
+	float orientation[4] = {0, 0, 0, 1};
+	float linearVelocity[3] = {};
+	float angularVelocity[3] = {};
+	uint32_t buttons = 0;
+	float axes[4] = {};
+	uint64_t sample = 0;
+};
+
+struct Snapshot {
+	int64_t writtenNs = 0;
+	uint32_t tracking = 0;
+	Device devices[3]; // head, left, right
+};
+
+// A consistent copy of the file; nullopt when it is missing, torn or of another layout.
+std::optional<Snapshot> Read();
+// CLOCK_MONOTONIC in nanoseconds (the file's clock).
+int64_t NowNs();
+// The headset is in its own inside-out tracking right now (fresh file, a tracking flag set, a head report seen).
+bool HeadsetTracksItself();
+
+} // namespace SharedMemoryPose
