+#pragma once
+#include "DistortionProfile.h"
+#include "PimaxDumpData.h"
+
+#include <cstdint>
+#include <memory>
+#include <string>
+
+#ifndef PVR_EXISTS
+// "Pimax Builtin (from dump)": the "Pimax Builtin" profile (PimaxDistortionProfile, Windows only) without PVR.
+// Instead of asking PVR at run time, it answers the same three questions from a dump of PVR taken on Windows
+// (see PimaxDumpData.h). The dump path is the headset config key "pimaxDumpPath"; empty means
+// <config folder>/pimax-distortion-dump.json (~/.config/CustomHeadset/pimax-distortion-dump.json).
+//
+// The dump's FOV is the FOV of the canted eyes (taken with view_rotation_fix 0), so while this profile is
+// selected PimaxCommon::PatchConfig forces parallelProjection off and sets eyeRotation to the dump's canting
+// angle (and the IPD, see there), which is what PVR gives the Windows driver with parallel projection off.
+class PimaxDumpDistortionProfile : public DistortionProfile {
+public:
+	static constexpr const char* kName = "Pimax Builtin (from dump)";
+	static constexpr const char* kType = "PimaxDump";
+
+	PimaxDumpDistortionProfile();
+
+	virtual void Initialize() override;
+
+	virtual void GetProjectionRaw(vr::EVREye eEye, float* pfLeft, float* pfRight, float* pfBottom, float* pfTop) override;
+
+	virtual Point2D ComputeDistortion(vr::EVREye eEye, ColorChannel colorChannel, float fU, float fV) override;
+
+	virtual void GetRecommendedRenderTargetSize(uint32_t* pnWidth, uint32_t* pnHeight) override;
+
+	bool IsValid() const { return dump != nullptr; }
+
+	// The cached dump for the configured path ("" = default). Loads it on first use. With checkForChanges the
+	// file is loaded again when its path or modification time changed; without it nothing touches the disk
+	// once a load was attempted (PatchConfig calls this on every GetConfig()). Returns nullptr if the dump
+	// cannot be used; the reason is logged once per load attempt.
+	static std::shared_ptr<const PimaxDumpData> GetDump(const std::string& configuredPath, bool checkForChanges);
+	static std::string ResolvePath(const std::string& configuredPath);
+
+private:
+	std::shared_ptr<const PimaxDumpData> dump;
+	// headset config pimaxDumpSquareDomain at Initialize (see PimaxDumpData::PanelUVFromDistortionUV)
+	bool squareDomain = false;
+};
+#endif
