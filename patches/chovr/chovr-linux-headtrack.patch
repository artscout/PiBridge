 void PimaxSlamDriver::HandleEvent(const vr::VREvent_t& event) {
+	if (event.eventType == vr::VREvent_Input_HapticVibration) {
+		static uint64_t seen = 0;
+		if (seen++ % 200 == 0) {
+			DriverLog("Haptic event for container %llu (%llu so far)", (unsigned long long)event.data.hapticVibration.containerHandle,
+				(unsigned long long)seen);
+		}
+		for (int side = 0; side < 2; side++) {
+			if (s_controllerDriver[side]) {
+				s_controllerDriver[side]->Vibrate(event.data.hapticVibration);
+			}
+		}
+	}
 }
 
