+	// A game's vibration for this controller: to PiBridge's pibridge-headtrack, which owns the headset's HID, as a
+	// request "SLOT AMP MS" (slot 2 left, 3 right) in $XDG_RUNTIME_DIR/pimax-haptic-request (written atomically).
+	void Vibrate(const vr::VREvent_HapticVibration_t& data) {
+		if (deviceIndex == vr::k_unTrackedDeviceIndexInvalid ||
+			vr::VRProperties()->TrackedDeviceToPropertyContainer(deviceIndex) != data.containerHandle) {
+			return;
+		}
+		if (vibrations++ % 200 == 0) {
+			DriverLog("Pimax controller %s: vibration %.2f for %.3f s (%llu so far)", role == vr::TrackedControllerRole_LeftHand ? "left" : "right",
+				data.fAmplitude, data.fDurationSeconds, (unsigned long long)vibrations);
+		}
+		// a zero amplitude is SteamVR's "nothing" / stop: it would overwrite the game's pulse before it is taken
+		if (!(data.fAmplitude > 0.0f)) {
+			return; // a duration of 0 is the shortest pulse (Monado's pimax_haptic: 20 ms), not nothing
+		}
+		const int slot = role == vr::TrackedControllerRole_LeftHand ? 2 : 3;
+		const int ampPct = std::clamp((int)lroundf(data.fAmplitude * 100.0f), 1, 100);
+		const int durMs = std::clamp((int)lroundf((data.fDurationSeconds > 0.02f ? data.fDurationSeconds : 0.02f) * 1000.0f), 1, 65535);
+		// one datagram per pulse to pibridge-headtrack's abstract socket "\0pibridge-haptic-<uid>" (no path: the
+		// Steam Runtime container's /tmp and environment do not matter, and no pulse overwrites another)
+		{
+			static int sock = socket(AF_UNIX, SOCK_DGRAM | SOCK_CLOEXEC, 0);
+			sockaddr_un a{};
+			a.sun_family = AF_UNIX;
+			const std::string n = "pibridge-haptic-" + std::to_string(getuid());
+			memcpy(a.sun_path + 1, n.data(), n.size());
+			const socklen_t len = (socklen_t)(offsetof(sockaddr_un, sun_path) + 1 + n.size());
+			char msg[32];
+			const int m = snprintf(msg, sizeof msg, "%d %d %d\n", slot, ampPct, durMs);
+			if (sock >= 0 && sendto(sock, msg, m, MSG_DONTWAIT, (const sockaddr*)&a, len) == m) {
+				if (writes++ % 200 == 0) {
+					DriverLog("Pimax controller vibration: sent to @%s (%llu so far)", n.c_str(), (unsigned long long)writes);
+				}
+				return;
+			}
+		}
+		// vrserver may run in the Steam Runtime container without XDG_RUNTIME_DIR (and with a /tmp of its own):
+		// the user's runtime directory by uid then, which the container shares
+		const char* rt = getenv("XDG_RUNTIME_DIR");
+		const std::string dir = rt != nullptr && *rt ? std::string(rt) : "/run/user/" + std::to_string(getuid());
+		const std::string path = dir + "/pimax-haptic-request";
+		const int amp = std::clamp((int)lroundf(data.fAmplitude * 100.0f), 1, 100);
+		const int ms = std::clamp((int)lroundf((data.fDurationSeconds > 0.02f ? data.fDurationSeconds : 0.02f) * 1000.0f), 1, 65535);
+		const std::string tmp = path + ".tmp";
+		FILE* f = fopen(tmp.c_str(), "w");
+		if (writes++ % 200 == 0 || f == nullptr) {
+			DriverLog("Pimax controller vibration request to %s: %s (%llu written)", path.c_str(),
+				f != nullptr ? "ok" : strerror(errno), (unsigned long long)writes);
