 	set(PIMAX_LENS_DIR "$ENV{HOME}/omarchyvr/rust/pimax-lens" CACHE PATH "Path to the pimax-lens crate (include/pimax_lens_rs.h)")
-	if(NOT EXISTS "${PIMAX_RUST_TARGET_DIR}/libpimax_lens.a")
