Monado Pimax driver: PIMAX_USE_PIBRIDGE links PiBridge's libpibridge_pimax.a instead of the Rust archives.
Base: omarchyvr forks/monado 0dff9fa2a (+ the Crystal Super driver diff). Apply with: git apply <this file>
Usage and the build recipe: docs/monado-abi.md, "The PiBridge-linked Monado".

diff --git a/src/xrt/drivers/CMakeLists.txt b/src/xrt/drivers/CMakeLists.txt
index f8430ed53..2e2244755 100644
--- a/src/xrt/drivers/CMakeLists.txt
+++ b/src/xrt/drivers/CMakeLists.txt
@@ -130,14 +130,53 @@ if(XRT_BUILD_DRIVER_PIMAX)
 	# Runtime switch: PIMAX_HANDS=mercury (or PIMAX_CAM=1 for capture only), see pimax/pimax_camera.h.
 	option(PIMAX_CAM "Pimax tracking cameras and Mercury hand tracking (needs libpimax_cam.a)" OFF)
 	set(PIMAX_CAM_DIR "$ENV{HOME}/omarchyvr/rust/pimax-cam" CACHE PATH "pimax-cam crate (include/pimax_cam.h)")
+	# PiBridge's C++ port of every Rust archive above (PiBridge monado-abi/, docs/monado-abi.md): ONE archive
+	# libpibridge_pimax.a with the same C ABI (pimax.h, pimax_hands.h, pimax_ctrlfuse.h, pimax_inhand.h, pimax_eye.h,
+	# pimax_cam.h, pimax_lens_rs.h; the headers are byte-identical copies). -DPIMAX_USE_PIBRIDGE=ON links it instead of
+	# libpimax_capi.a, libpimax_cam.a and libpimax_lens.a; the driver sources do not change.
+	option(PIMAX_USE_PIBRIDGE "Link PiBridge's libpibridge_pimax.a (C++) instead of the Rust archives" OFF)
+	set(PIMAX_PIBRIDGE_LIB "" CACHE FILEPATH "PiBridge's libpibridge_pimax.a (<pibridge build>/monado-abi/libpibridge_pimax.a)")
+	set(PIMAX_PIBRIDGE_INCLUDE "" CACHE PATH "PiBridge's monado-abi/include (the seven C ABI headers)")
+	if(PIMAX_USE_PIBRIDGE)
+		if(NOT EXISTS "${PIMAX_PIBRIDGE_LIB}")
+			message(FATAL_ERROR "pimax driver: PIMAX_USE_PIBRIDGE=ON but PIMAX_PIBRIDGE_LIB (\"${PIMAX_PIBRIDGE_LIB}\") does not exist")
+		endif()
+		foreach(h pimax.h pimax_hands.h pimax_ctrlfuse.h pimax_inhand.h pimax_eye.h pimax_cam.h pimax_lens_rs.h)
+			if(NOT EXISTS "${PIMAX_PIBRIDGE_INCLUDE}/${h}")
+				message(FATAL_ERROR "pimax driver: PIMAX_PIBRIDGE_INCLUDE (\"${PIMAX_PIBRIDGE_INCLUDE}\") has no ${h}")
+			endif()
+		endforeach()
+		find_package(ZLIB REQUIRED)
+		# C++ inside: link with the C++ linker (Monado's targets do already); zlib for the .pxcam recorder.
+		add_library(pimax_pibridge STATIC IMPORTED GLOBAL)
+		set_target_properties(
+			pimax_pibridge PROPERTIES IMPORTED_LOCATION "${PIMAX_PIBRIDGE_LIB}" IMPORTED_LINK_INTERFACE_LANGUAGES CXX
+			INTERFACE_LINK_LIBRARIES "ZLIB::ZLIB;Threads::Threads;${CMAKE_DL_LIBS};m;rt"
+			)
+		set(PIMAX_LIB_CAPI pimax_pibridge)
+		set(PIMAX_LIB_CAM pimax_pibridge)
+		set(PIMAX_LIB_LENS pimax_pibridge)
+		set(PIMAX_INC_LIBPIMAX ${PIMAX_PIBRIDGE_INCLUDE})
+		set(PIMAX_INC_HANDS ${PIMAX_PIBRIDGE_INCLUDE})
+		set(PIMAX_INC_EYE ${PIMAX_PIBRIDGE_INCLUDE})
+		set(PIMAX_INC_CAM ${PIMAX_PIBRIDGE_INCLUDE})
+		set(PIMAX_INC_LENS ${PIMAX_PIBRIDGE_INCLUDE})
+	else()
+		set(PIMAX_LIB_CAPI ${PIMAX_RUST_TARGET_DIR}/libpimax_capi.a)
+		set(PIMAX_LIB_CAM ${PIMAX_RUST_TARGET_DIR}/libpimax_cam.a)
+		set(PIMAX_LIB_LENS ${PIMAX_RUST_TARGET_DIR}/libpimax_lens.a)
+		set(PIMAX_INC_LIBPIMAX ${PIMAX_LIBPIMAX_DIR}/include)
+		set(PIMAX_INC_HANDS ${PIMAX_HANDS_DIR}/include)
+		set(PIMAX_INC_CAM ${PIMAX_CAM_DIR}/include)
+	endif()
 	set(PIMAX_DRIVER_SOURCES
 		pimax/pimax_hmd.c pimax/pimax_lens.c pimax/pimax_lens.h pimax/pimax_interface.h pimax/pimax_prober.c pimax/pimax_ctrl.c pimax/pimax_ctrl.h pimax/pimax_ctrltrack_shm.h
 		pimax/pimax_camera.c pimax/pimax_camera.h pimax/pimax_eyeglue.c pimax/pimax_eyeglue.h
 		)
-	if(PIMAX_USE_RUST_LIBPIMAX)
+	if(PIMAX_USE_RUST_LIBPIMAX OR PIMAX_USE_PIBRIDGE)
 		add_library(drv_pimax STATIC ${PIMAX_DRIVER_SOURCES})
 		# native-static-libs reported by rustc for the staticlib: -lgcc_s -lutil -lrt -lpthread -lm -ldl -lc
-		target_link_libraries(drv_pimax PRIVATE ${PIMAX_RUST_TARGET_DIR}/libpimax_capi.a ${CMAKE_DL_LIBS} m rt util Threads::Threads)
+		target_link_libraries(drv_pimax PRIVATE ${PIMAX_LIB_CAPI} ${CMAKE_DL_LIBS} m rt util Threads::Threads)
 	else()
 		add_library(drv_pimax STATIC ${PIMAX_DRIVER_SOURCES} ${PIMAX_LIBPIMAX_DIR}/src/pimax.c ${PIMAX_LIBPIMAX_DIR}/src/decode.c)
 		target_link_libraries(drv_pimax PRIVATE ${PIMAX_RUST_TARGET_DIR}/libpimax_hands.a ${CMAKE_DL_LIBS} m rt util Threads::Threads)
@@ -146,13 +185,16 @@ if(XRT_BUILD_DRIVER_PIMAX)
 	# Eye gaze (rust/pimax-eye, header include/pimax_eye.h, code in libpimax_capi.a like the hands). PIMAX_EYE=1 at run time.
 	# The C libpimax build has no eye code: pimax_eyeglue.c needs PIMAX_USE_RUST_LIBPIMAX=ON.
 	set(PIMAX_EYE_DIR "$ENV{HOME}/omarchyvr/rust/pimax-eye" CACHE PATH "Path to the pimax-eye crate (include/pimax_eye.h)")
-	target_include_directories(drv_pimax PRIVATE ${PIMAX_LIBPIMAX_DIR}/include ${PIMAX_HANDS_DIR}/include ${PIMAX_EYE_DIR}/include)
+	if(NOT PIMAX_USE_PIBRIDGE)
+		set(PIMAX_INC_EYE ${PIMAX_EYE_DIR}/include)
+	endif()
+	target_include_directories(drv_pimax PRIVATE ${PIMAX_INC_LIBPIMAX} ${PIMAX_INC_HANDS} ${PIMAX_INC_EYE})
 	target_link_libraries(drv_pimax PRIVATE xrt-interfaces aux_util aux_math Threads::Threads)
 	if(PIMAX_CAM)
 		target_compile_definitions(drv_pimax PRIVATE PIMAX_HAVE_CAM)
-		target_include_directories(drv_pimax PRIVATE ${PIMAX_CAM_DIR}/include)
+		target_include_directories(drv_pimax PRIVATE ${PIMAX_INC_CAM})
 		target_link_libraries(
-			drv_pimax PRIVATE ${PIMAX_RUST_TARGET_DIR}/libpimax_cam.a ${CMAKE_DL_LIBS} m rt util aux_util_sink
+			drv_pimax PRIVATE ${PIMAX_LIB_CAM} ${CMAKE_DL_LIBS} m rt util aux_util_sink
 					  aux_tracking drv_multi
 			)
 		if(XRT_BUILD_DRIVER_HANDTRACKING)
@@ -160,10 +202,10 @@ if(XRT_BUILD_DRIVER_PIMAX)
 			target_link_libraries(drv_pimax PRIVATE drv_ht t_ht_mercury)
 			# Offline Mercury bench on .pxcam recordings (no headset, no service): pimax_ht_bench SRC.pxcam
 			add_executable(pimax_ht_bench pimax/pimax_ht_bench.c pimax/pimax_ht_bench_png.cpp pimax/pimax_ht_calib.c)
-			target_include_directories(pimax_ht_bench PRIVATE ${PIMAX_CAM_DIR}/include)
+			target_include_directories(pimax_ht_bench PRIVATE ${PIMAX_INC_CAM})
 			target_link_libraries(
 				pimax_ht_bench PRIVATE xrt-interfaces aux_util aux_math aux_tracking t_ht_mercury ${OpenCV_LIBRARIES}
-						       ${PIMAX_RUST_TARGET_DIR}/libpimax_cam.a ${CMAKE_DL_LIBS} m rt util Threads::Threads
+						       ${PIMAX_LIB_CAM} ${CMAKE_DL_LIBS} m rt util Threads::Threads
 				)
 		endif()
 	endif()
@@ -173,13 +215,16 @@ if(XRT_BUILD_DRIVER_PIMAX)
 	# pimax_lens.c is thin glue over its C ABI. libpimax_lens.a is built next to libpimax_capi.a:
