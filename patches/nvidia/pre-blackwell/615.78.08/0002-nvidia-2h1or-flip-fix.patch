+/*
+ * Return the main layer channels of all the hardware heads which are merged
+ * into the same api head as 'head' (2Heads1OR), including 'head' itself.
+ */
+static NVEvoChannelMask MergedMainLayerChannelMask(const NVDevEvoRec *pDevEvo,
+                                                   const NvU32 head)
+{
+    const NVDispEvoRec *pDispEvo = pDevEvo->pDispEvo[0];
+    NVEvoChannelMask channelMask =
+        pDevEvo->head[head].layer[NVKMS_MAIN_LAYER]->channelMask;
+    NvU32 apiHead;
+
+    if (pDispEvo == NULL) {
+        return channelMask;
+    }
+
+    for (apiHead = 0; apiHead < ARRAY_LEN(pDispEvo->apiHeadState); apiHead++) {
+        const NvU32 hwHeadsMask = pDispEvo->apiHeadState[apiHead].hwHeadsMask;
+        NvU32 mergedHead;
+
+        if ((hwHeadsMask & NVBIT(head)) == 0x0) {
+            continue;
+        }
+
+        FOR_EACH_EVO_HW_HEAD_IN_MASK(hwHeadsMask, mergedHead) {
+            if (mergedHead < pDevEvo->numHeads) {
+                channelMask |= pDevEvo->head[mergedHead].
+                    layer[NVKMS_MAIN_LAYER]->channelMask;
+            }
+        }
+        break;
+    }
+
+    return channelMask;
+}
