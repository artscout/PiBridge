diff --git a/kernel-open/nvidia-drm/nvidia-drm-drv.c b/kernel-open/nvidia-drm/nvidia-drm-drv.c
index 64df8c0..5d06ac2 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-drv.c
+++ b/kernel-open/nvidia-drm/nvidia-drm-drv.c
@@ -1284,6 +1284,98 @@ static NvU32 nv_drm_get_head_bit_from_connector(struct drm_connector *connector)
     return 0;
 }
 
+static int __nv_drm_revoke_modeset_permission_locked(
+    struct drm_device *dev,
+    struct drm_modeset_acquire_ctx *pctx,
+    struct drm_file *filep, NvU32 dpyId);
+
+/*
+ * The modeset permission bookkeeping (nv_drm_connector::modeset_permission_filep
+ * and nv_drm_crtc::modeset_permission_filep) stores drm_file pointers without
+ * holding a reference: check whether such a pointer still names an open file
+ * of this device.
+ */
+static bool nv_drm_file_is_open(struct drm_device *dev,
+                                const struct drm_file *filep)
+{
+    struct drm_file *f;
+    bool open = false;
+
+    mutex_lock(&dev->filelist_mutex);
+    list_for_each_entry(f, &dev->filelist, lhead) {
+        if (f == filep) {
+            open = true;
+            break;
+        }
+    }
+    mutex_unlock(&dev->filelist_mutex);
+
+    return open;
+}
+
+/*
+ * Drop modeset permissions which are still recorded for a file that has been
+ * closed.  nv_drm_postclose() revokes the permissions of a file, but if that
+ * ever does not happen the connector and its crtc stay marked as granted, the
+ * head keeps scanning out for a client which no longer exists, and every later
+ * grant of that connector is refused until the module is reloaded.  The
+ * detect path only cleans this up when the connector reads as disconnected,
+ * which never happens for a display with a "connected" override.
+ *
+ * Must be called with the modeset locks held.
+ */
+static void nv_drm_drop_stale_modeset_permissions(
+    struct drm_device *dev,
+    struct drm_modeset_acquire_ctx *pctx)
+{
+    struct nv_drm_device *nv_dev = to_nv_device(dev);
+    int tries;
+
+    /* Each iteration removes every mark of one closed file. */
+    for (tries = 0; tries < 16; tries++) {
+        struct drm_file *stale = NULL;
+        struct drm_connector *connector;
+        struct drm_crtc *crtc;
+        struct drm_connector_list_iter conn_iter;
+
+        drm_connector_list_iter_begin(dev, &conn_iter);
+        drm_for_each_connector_iter(connector, &conn_iter) {
+            struct nv_drm_connector *nv_connector = to_nv_connector(connector);
+
+            if (nv_connector->modeset_permission_filep &&
+                !nv_drm_file_is_open(dev,
+                                     nv_connector->modeset_permission_filep)) {
+                stale = nv_connector->modeset_permission_filep;
+                break;
+            }
+        }
+        drm_connector_list_iter_end(&conn_iter);
+
+        if (!stale) {
+            nv_drm_for_each_crtc(crtc, dev) {
+                struct nv_drm_crtc *nv_crtc = to_nv_crtc(crtc);
+
+                if (nv_crtc->modeset_permission_filep &&
+                    !nv_drm_file_is_open(dev,
+                                         nv_crtc->modeset_permission_filep)) {
+                    stale = nv_crtc->modeset_permission_filep;
+                    break;
+                }
+            }
+        }
+
+        if (!stale) {
+            return;
+        }
+
+        NV_DRM_DEV_LOG_INFO(
+            nv_dev,
+            "Revoking a modeset permission which was left behind by a closed file");
+
+        __nv_drm_revoke_modeset_permission_locked(dev, pctx, stale, 0);
+    }
+}
+
 static int nv_drm_grant_modeset_permission(struct drm_device *dev,
                                            struct drm_nvidia_grant_permissions_params *params,
                                            struct drm_file *filep)
@@ -1296,14 +1388,19 @@ static int nv_drm_grant_modeset_permission(struct drm_device *dev,
     NvU32 head = 0, freeHeadBits, targetHeadBit, possible_crtcs;
     int ret = 0;
     struct drm_connector_list_iter conn_iter;
+    struct drm_modeset_acquire_ctx *pctx;
 #if NV_DRM_MODESET_LOCK_ALL_END_ARGUMENT_COUNT == 3
     struct drm_modeset_acquire_ctx ctx;
     DRM_MODESET_LOCK_ALL_BEGIN(dev, ctx, DRM_MODESET_ACQUIRE_INTERRUPTIBLE,
                                ret);
+    pctx = &ctx;
 #else
     mutex_lock(&dev->mode_config.mutex);
+    pctx = dev->mode_config.acquire_ctx;
 #endif
 
+    nv_drm_drop_stale_modeset_permissions(dev, pctx);
+
     /* Get the connector for the dpyId. */
     drm_connector_list_iter_begin(dev, &conn_iter);
     drm_for_each_connector_iter(connector, &conn_iter) {
@@ -1475,8 +1572,8 @@ nv_drm_atomic_disable_connector(nv_drm_atomic_state_base_t *state,
     if (nv_connector->modeset_permission_crtc) {
         crtc_state = drm_atomic_get_crtc_state(
             state, &nv_connector->modeset_permission_crtc->base);
-        if (!crtc_state) {
-            return -EINVAL;
+        if (IS_ERR_OR_NULL(crtc_state)) {
+            return crtc_state ? PTR_ERR(crtc_state) : -EINVAL;
         }
 
         crtc_state->active = false;
@@ -1487,38 +1584,41 @@ nv_drm_atomic_disable_connector(nv_drm_atomic_state_base_t *state,
     }
 
     connector_state = drm_atomic_get_connector_state(state, &nv_connector->base);
-    if (!connector_state) {
-        return -EINVAL;
+    if (IS_ERR_OR_NULL(connector_state)) {
+        return connector_state ? PTR_ERR(connector_state) : -EINVAL;
     }
 
     return drm_atomic_set_crtc_for_connector(connector_state, NULL);
 }
 
-static int nv_drm_revoke_modeset_permission(struct drm_device *dev,
-                                            struct drm_file *filep, NvU32 dpyId)
+/*
+ * Revoke the modeset permissions of 'filep': all of them if dpyId is 0 (the
+ * file is being closed), or only the ones of that display.
+ *
+ * The grant is always dropped, both here and in NVKMS, even if the atomic
+ * state which disables the connector cannot be allocated, staged or
+ * committed: a grant that stays behind cannot be removed by anyone later (see
+ * nv_drm_drop_stale_modeset_permissions()).
+ *
+ * Must be called with the modeset locks held.
+ */
+static int __nv_drm_revoke_modeset_permission_locked(
+    struct drm_device *dev,
+    struct drm_modeset_acquire_ctx *pctx,
+    struct drm_file *filep, NvU32 dpyId)
 {
-    struct drm_modeset_acquire_ctx *pctx;
     nv_drm_atomic_state_base_t *state;
     struct drm_connector *connector;
     struct drm_crtc *crtc;
     int ret = 0;
     struct drm_connector_list_iter conn_iter;
-#if NV_DRM_MODESET_LOCK_ALL_END_ARGUMENT_COUNT == 3
-    struct drm_modeset_acquire_ctx ctx;
-    DRM_MODESET_LOCK_ALL_BEGIN(dev, ctx, DRM_MODESET_ACQUIRE_INTERRUPTIBLE,
-                               ret);
-    pctx = &ctx;
-#else
-    mutex_lock(&dev->mode_config.mutex);
-    pctx = dev->mode_config.acquire_ctx;
-#endif
 
     state = nv_drm_atomic_state_base_alloc(dev);
-    if (!state) {
+    if (state) {
+        state->acquire_ctx = pctx;
+    } else {
         ret = -ENOMEM;
-        goto done;
     }
-    state->acquire_ctx = pctx;
 
     /*
      * If dpyId is set, only revoke those specific resources. Otherwise,
@@ -1529,9 +1629,8 @@ static int nv_drm_revoke_modeset_permission(struct drm_device *dev,
         struct nv_drm_connector *nv_connector = to_nv_connector(connector);
         if (nv_connector->modeset_permission_filep == filep &&
             (!dpyId || nv_drm_connector_is_dpy_id(connector, dpyId))) {
-            ret = nv_drm_atomic_disable_connector(state, nv_connector);
-            if (ret < 0) {
-                goto done;
+            if (ret == 0) {
+                ret = nv_drm_atomic_disable_connector(state, nv_connector);
             }
 
             // Continue trying to revoke as much as possible.
@@ -1547,9 +1646,40 @@ static int nv_drm_revoke_modeset_permission(struct drm_device *dev,
         }
     }
 
-    ret = drm_atomic_commit(state);
-done:
-    nv_drm_atomic_state_base_put(state);
+    if (ret == 0) {
+        ret = drm_atomic_commit(state);
+    }
+
+    if (state) {
+        nv_drm_atomic_state_base_put(state);
+    }
+
+    return ret;
+}
+
+static int nv_drm_revoke_modeset_permission(struct drm_device *dev,
+                                            struct drm_file *filep, NvU32 dpyId)
+{
+    struct drm_modeset_acquire_ctx *pctx;
+    int ret = 0;
+#if NV_DRM_MODESET_LOCK_ALL_END_ARGUMENT_COUNT == 3
+    struct drm_modeset_acquire_ctx ctx;
+    /*
+     * Not DRM_MODESET_ACQUIRE_INTERRUPTIBLE: this is also the release path of
+     * the file (nv_drm_postclose()), and a process which was killed runs it
+     * with the fatal signal still pending.  An interruptible acquisition then
+     * fails with -EINTR as soon as one of the modeset locks is contended, and
+     * DRM_MODESET_LOCK_ALL_BEGIN() jumps past the whole revoke: the connector
+     * and the crtc stay granted to a file which no longer exists.
+     */
+    DRM_MODESET_LOCK_ALL_BEGIN(dev, ctx, 0, ret);
+    pctx = &ctx;
+#else
+    mutex_lock(&dev->mode_config.mutex);
+    pctx = dev->mode_config.acquire_ctx;
+#endif
+
+    ret = __nv_drm_revoke_modeset_permission_locked(dev, pctx, filep, dpyId);
 
 #if NV_DRM_MODESET_LOCK_ALL_END_ARGUMENT_COUNT == 3
     DRM_MODESET_LOCK_ALL_END(dev, ctx, ret);
