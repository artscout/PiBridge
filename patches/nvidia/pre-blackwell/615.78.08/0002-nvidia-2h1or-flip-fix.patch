diff --git a/src/nvidia-modeset/src/nvkms-hw-flip.c b/src/nvidia-modeset/src/nvkms-hw-flip.c
index bd65888..a79fb48 100644
--- a/src/nvidia-modeset/src/nvkms-hw-flip.c
+++ b/src/nvidia-modeset/src/nvkms-hw-flip.c
@@ -1166,6 +1166,91 @@ static NvBool UpdateOverlayLayerFlipEvoHwState(
     return TRUE;
 }
 
+/*!
+ * 2Heads1OR: restrict the client's flip sync objects to the primary hardware
+ * head.
+ *
+ * The NvKmsFlipCommonParams of an api head are applied to every hardware head
+ * which is merged into that api head (see nvFlipEvo() and the modeset path),
+ * so without this the semaphores and the completion notifier of one client
+ * flip are executed once per hardware head: every window channel waits on the
+ * acquire semaphore, and every window channel writes the release value and the
+ * notifier.  Clients implement their flip protocol for exactly one acquire and
+ * one release per flip, with the release written when the channel flips away
+ * from the buffer.  If the merged heads do not latch a flip on the same frame,
+ * the release of the head which is behind lands after the client has already
+ * written the acquire value of a later flip to the same semaphore, that later
+ * flip can never be acquired by any of the merged window channels, and the
+ * client's rendering channel waits forever for the corresponding release.
+ * (nvkms-headsurface.c states the same rule for its emulation of these
+ * semantics: semaphores must not be released out of order.)
+ *
+ * The primary hardware head (mergeHeadSection == 0) keeps the sync objects;
+ * the flip occurred event is registered on its channels only as well.  The
+ * secondary heads follow it: their window channels are interlocked and flip
+ * locked with the primary's (see ProcessFlipLockUpdates()), exactly like a
+ * core channel update which is interlocked with a window channel that waits
+ * on a semaphore.
+ *
+ * The module parameter "merged_head_sync" selects the behavior, see
+ * NVKMS_MERGED_HEAD_SYNC_*.
+ */
+static void LimitMergedHeadSyncObjects(
+    const NVDevEvoRec *pDevEvo,
+    const NvU32 head,
+    const NvU8 mergeHeadSection,
+    NVFlipEvoHwState *pFlipState)
+{
+    NvU32 mode = nvkms_merged_head_sync();
+    NvU32 layer;
+
+    if ((mergeHeadSection == 0) ||
+        (mode == NVKMS_MERGED_HEAD_SYNC_ALL_HEADS)) {
+        return;
+    }
+
+    /*
+     * An acquire without a release needs independent acquire and release
+     * semaphores in the window channel.
+     */
+    if ((mode == NVKMS_MERGED_HEAD_SYNC_RELEASE_PRIMARY_ONLY) &&
+        !pDevEvo->hal->caps.supportsIndependentAcqRelSemaphore) {
+        mode = NVKMS_MERGED_HEAD_SYNC_PRIMARY_ONLY;
+    }
+
+    for (layer = 0; layer < pDevEvo->head[head].numLayers; layer++) {
+        NVFlipChannelEvoHwState *pHwState = &pFlipState->layer[layer];
+
+        /*
+         * Only touch the layers which this request programs.  The state of
+         * the other layers is the snapshot of what is in the hardware, which
+         * went through here when it was programmed, and whose surface
+         * references are held by the current state.
+         */
+        if (!pFlipState->dirty.layer[layer]) {
+            continue;
+        }
+
+        nvkms_memset(&pHwState->completionNotifier, 0,
+                     sizeof(pHwState->completionNotifier));
+
+        /* Syncpts are per channel already, see AssignPostSyncptEvoHwState(). */
+        if (pHwState->syncObject.usingSyncpt) {
+            continue;
+        }
+
+        if (mode != NVKMS_MERGED_HEAD_SYNC_RELEASE_PRIMARY_ONLY) {
+            nvkms_memset(&pHwState->syncObject.u.semaphores.acquireSurface, 0,
+                         sizeof(pHwState->syncObject.u.semaphores.acquireSurface));
+            pHwState->syncObject.u.semaphores.acquireValue = 0;
+        }
+
+        nvkms_memset(&pHwState->syncObject.u.semaphores.releaseSurface, 0,
+                     sizeof(pHwState->syncObject.u.semaphores.releaseSurface));
+        pHwState->syncObject.u.semaphores.releaseValue = 0;
+    }
+}
