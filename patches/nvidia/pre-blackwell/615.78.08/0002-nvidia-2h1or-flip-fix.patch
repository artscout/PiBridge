+/*
+ * Diagnostics for flips on merged hardware heads (2Heads1OR).
+ *
+ * The last NV_MERGED_FLIP_TRACE_LEN main layer flips which were programmed on
+ * merged heads are kept in a ring, together with the value which the flip's
+ * semaphores held when the flip was programmed.  nvLogStuckLayerChannel()
+ * prints the ring when a layer channel cannot be idled, which is the only
+ * moment at which the state of the client's flip protocol is of interest.
+ * With debug logging enabled (module parameter "debug") the first flips after
+ * a merged head starts to display a surface are printed as they happen.
+ *
+ * All of this runs under the nvkms lock.
+ */
+#define NV_MERGED_FLIP_TRACE_LEN          16
+#define NV_MERGED_FLIP_TRACE_PRINT_BUDGET 24
+
+typedef struct {
+    NvU64 usec;
+    NvU8 head;
+    NvU8 mergeHeadSection;
+    NvU8 minPresentInterval;
+    NvBool surface            : 1;
+    NvBool tearing            : 1;
+    NvBool skipPendingFlips   : 1;
+    NvBool notifier           : 1;
+    NvBool notifierAwaken     : 1;
+    NvBool acquire            : 1;
+    NvBool acquireHeldValid   : 1;
+    NvBool release            : 1;
+    NvBool releaseHeldValid   : 1;
+    NvBool sameSemaphore      : 1;
+    NvU16 notifierOffsetInWords;
+    NvU16 acquireOffsetInWords;
+    NvU16 releaseOffsetInWords;
+    NvU32 acquireValue;
+    NvU32 acquireHeld;
+    NvU32 releaseValue;
+    NvU32 releaseHeld;
+} NVMergedFlipTraceEntry;
+
+static NVMergedFlipTraceEntry mergedFlipTrace[NV_MERGED_FLIP_TRACE_LEN];
+static NvU32 mergedFlipTraceCount;
+static NvU32 mergedFlipTraceLogged;
+static NvU32 mergedFlipTracePrintBudget;
+
+/*
+ * Read the current payload of a flip semaphore through the CPU mapping which
+ * NVKMS keeps of NISO surfaces.  Returns FALSE if there is nothing to read.
+ */
+static NvBool ReadFlipSemaphore(const NVFlipNIsoSurfaceEvoHwState *pNIso,
+                                const NvU32 sd,
+                                NvU32 *pPayload)
+{
+    const NVSurfaceEvoRec *pSurfaceEvo = pNIso->pSurfaceEvo;
+    const NvU64 offsetInBytes = ((NvU64)pNIso->offsetInWords) * 4;
+    const NvU32 size = nvKmsSizeOfSemaphore();
+    struct nvKmsParsedSemaphore parsed = { };
+
+    if ((pSurfaceEvo == NULL) || (pSurfaceEvo->cpuAddress[sd] == NULL)) {
+        return FALSE;
+    }
+
+    if (((offsetInBytes % size) != 0) ||
+        ((offsetInBytes + size) > pSurfaceEvo->planes[0].rmObjectSizeInBytes)) {
+        return FALSE;
+    }
+
+    nvKmsParseSemaphore((NvU32)(offsetInBytes / size),
+                        pSurfaceEvo->cpuAddress[sd], &parsed);
+
+    *pPayload = parsed.payload;
+
+    return TRUE;
+}
+
+static void LogMergedFlipTraceEntry(const NVDevEvoRec *pDevEvo,
+                                    const char *prefix,
+                                    const NVMergedFlipTraceEntry *pEntry)
+{
+    char acquire[64], release[64], notifier[32];
+
+    if (pEntry->acquire) {
+        if (pEntry->acquireHeldValid) {
+            nvkms_snprintf(acquire, sizeof(acquire), "+%u ==0x%08x (held 0x%08x)",
+                           pEntry->acquireOffsetInWords, pEntry->acquireValue,
+                           pEntry->acquireHeld);
+        } else {
+            nvkms_snprintf(acquire, sizeof(acquire), "+%u ==0x%08x",
+                           pEntry->acquireOffsetInWords, pEntry->acquireValue);
+        }
+    } else {
+        nvkms_snprintf(acquire, sizeof(acquire), "none");
+    }
+
+    if (pEntry->release) {
+        if (pEntry->releaseHeldValid) {
+            nvkms_snprintf(release, sizeof(release), "%s+%u :=0x%08x (held 0x%08x)",
+                           pEntry->sameSemaphore ? "same " : "",
+                           pEntry->releaseOffsetInWords, pEntry->releaseValue,
+                           pEntry->releaseHeld);
+        } else {
+            nvkms_snprintf(release, sizeof(release), "%s+%u :=0x%08x",
+                           pEntry->sameSemaphore ? "same " : "",
+                           pEntry->releaseOffsetInWords, pEntry->releaseValue);
+        }
+    } else {
+        nvkms_snprintf(release, sizeof(release), "none");
+    }
+
+    if (pEntry->notifier) {
+        nvkms_snprintf(notifier, sizeof(notifier), "+%u%s",
+                       pEntry->notifierOffsetInWords,
+                       pEntry->notifierAwaken ? " awaken" : "");
+    } else {
+        nvkms_snprintf(notifier, sizeof(notifier), "none");
+    }
+
+    nvEvoLogDev(pDevEvo, EVO_LOG_INFO,
+                "%s t=%llu us head %u section %u: %s mpi %u%s%s; "
+                "acquire %s; release %s; notifier %s",
+                prefix, (unsigned long long)pEntry->usec,
+                pEntry->head, pEntry->mergeHeadSection,
+                pEntry->surface ? "surface" : "NULL",
+                pEntry->minPresentInterval,
+                pEntry->tearing ? " tearing" : "",
+                pEntry->skipPendingFlips ? " skipPendingFlips" : "",
+                acquire, release, notifier);
+}
+
+static void TraceMergedHeadFlip(const NVDevEvoRec *pDevEvo,
+                                const NvU32 sd,
+                                const NvU32 head,
+                                const NvU8 mergeHeadSection,
+                                const NvBool firstSurface,
+                                const NVFlipEvoHwState *pFlipState)
+{
+    const NVFlipChannelEvoHwState *pHwState =
+        &pFlipState->layer[NVKMS_MAIN_LAYER];
+    NVMergedFlipTraceEntry *pEntry =
+        &mergedFlipTrace[mergedFlipTraceCount % NV_MERGED_FLIP_TRACE_LEN];
+
+    nvkms_memset(pEntry, 0, sizeof(*pEntry));
+
+    pEntry->usec = nvkms_get_usec();
+    pEntry->head = head;
+    pEntry->mergeHeadSection = mergeHeadSection;
+    pEntry->minPresentInterval = pHwState->minPresentInterval;
+    pEntry->surface = (pHwState->pSurfaceEvo[NVKMS_LEFT] != NULL);
+    pEntry->tearing = pHwState->tearing;
+    pEntry->skipPendingFlips =
+        pFlipState->skipLayerPendingFlips[NVKMS_MAIN_LAYER];
+
+    if (pHwState->completionNotifier.surface.pSurfaceEvo != NULL) {
+        pEntry->notifier = TRUE;
+        pEntry->notifierAwaken = pHwState->completionNotifier.awaken;
+        pEntry->notifierOffsetInWords =
+            pHwState->completionNotifier.surface.offsetInWords;
+    }
+
+    if (!pHwState->syncObject.usingSyncpt) {
+        const NVFlipNIsoSurfaceEvoHwState *pAcquire =
+            &pHwState->syncObject.u.semaphores.acquireSurface;
+        const NVFlipNIsoSurfaceEvoHwState *pRelease =
+            &pHwState->syncObject.u.semaphores.releaseSurface;
+
+        if (pAcquire->pSurfaceEvo != NULL) {
+            pEntry->acquire = TRUE;
+            pEntry->acquireOffsetInWords = pAcquire->offsetInWords;
+            pEntry->acquireValue =
+                pHwState->syncObject.u.semaphores.acquireValue;
+            pEntry->acquireHeldValid =
+                ReadFlipSemaphore(pAcquire, sd, &pEntry->acquireHeld);
+        }
+
+        if (pRelease->pSurfaceEvo != NULL) {
+            pEntry->release = TRUE;
+            pEntry->releaseOffsetInWords = pRelease->offsetInWords;
+            pEntry->releaseValue =
+                pHwState->syncObject.u.semaphores.releaseValue;
+            pEntry->releaseHeldValid =
+                ReadFlipSemaphore(pRelease, sd, &pEntry->releaseHeld);
+            pEntry->sameSemaphore =
+                (pAcquire->pSurfaceEvo == pRelease->pSurfaceEvo) &&
+                (pAcquire->offsetInWords == pRelease->offsetInWords);
+        }
+    }
+
+    mergedFlipTraceCount++;
+
+    if (!nvDoDebugLogging()) {
+        return;
+    }
+
+    if (firstSurface) {
+        mergedFlipTracePrintBudget = NV_MERGED_FLIP_TRACE_PRINT_BUDGET;
+    }
+
+    if (mergedFlipTracePrintBudget > 0) {
+        mergedFlipTracePrintBudget--;
+        LogMergedFlipTraceEntry(pDevEvo, "2Heads1OR flip", pEntry);
+    }
+}
+
+/*!
+ * Print what is known about a layer channel which could not be idled: where
+ * the hardware stopped in its pushbuffer, the sync objects of the flip which
+ * was programmed last together with the values which its semaphores hold now,
+ * and, for merged heads, the recent flips.
+ */
+void nvLogStuckLayerChannel(NVDevEvoPtr pDevEvo, NVEvoChannelPtr pChannel)
+{
+    const NVDispEvoRec *pDispEvo = pDevEvo->pDispEvo[0];
+    const NVFlipChannelEvoHwState *pHwState = NULL;
+    NvU32 sd, head, layer = 0;
+    NvU32 get = 0, put = 0;
+    NvBool found = FALSE;
+    char acquire[80], release[80];
+
+    if ((pDispEvo == NULL) || (pChannel == NULL)) {
+        return;
+    }
+
+    sd = pDispEvo->displayOwner;
+
+    for (head = 0; (head < pDevEvo->numHeads) && !found; head++) {
+        for (layer = 0; layer < pDevEvo->head[head].numLayers; layer++) {
+            if (pDevEvo->head[head].layer[layer] == pChannel) {
+                found = TRUE;
+                break;
+            }
+        }
+        if (found) {
+            break;
+        }
+    }
+
+    /* Not a layer channel (e.g., the core channel): nothing to add. */
+    if (!found) {
+        return;
+    }
+
+    pHwState = &pDevEvo->gpus[sd].headState[head].layer[layer];
+
+    nvEvoReadChannelGetPut(pChannel, &get, &put);
+
+    nvkms_snprintf(acquire, sizeof(acquire), "none");
+    nvkms_snprintf(release, sizeof(release), "none");
+
+    if (!pHwState->syncObject.usingSyncpt) {
+        const NVFlipNIsoSurfaceEvoHwState *pAcquire =
+            &pHwState->syncObject.u.semaphores.acquireSurface;
+        const NVFlipNIsoSurfaceEvoHwState *pRelease =
+            &pHwState->syncObject.u.semaphores.releaseSurface;
+        NvU32 held = 0;
+
+        if (pAcquire->pSurfaceEvo != NULL) {
+            if (ReadFlipSemaphore(pAcquire, sd, &held)) {
+                nvkms_snprintf(acquire, sizeof(acquire),
+                               "+%u ==0x%08x (holds 0x%08x: %s)",
+                               pAcquire->offsetInWords,
+                               pHwState->syncObject.u.semaphores.acquireValue,
+                               held,
+                               (held ==
+                                pHwState->syncObject.u.semaphores.acquireValue) ?
+                                   "satisfied" : "NOT satisfied");
+            } else {
+                nvkms_snprintf(acquire, sizeof(acquire), "+%u ==0x%08x",
+                               pAcquire->offsetInWords,
+                               pHwState->syncObject.u.semaphores.acquireValue);
+            }
+        }
+
+        if (pRelease->pSurfaceEvo != NULL) {
+            if (ReadFlipSemaphore(pRelease, sd, &held)) {
+                nvkms_snprintf(release, sizeof(release),
+                               "+%u :=0x%08x (holds 0x%08x)",
+                               pRelease->offsetInWords,
+                               pHwState->syncObject.u.semaphores.releaseValue,
+                               held);
+            } else {
+                nvkms_snprintf(release, sizeof(release), "+%u :=0x%08x",
+                               pRelease->offsetInWords,
+                               pHwState->syncObject.u.semaphores.releaseValue);
+            }
+        }
+    }
+
+    nvEvoLogDev(pDevEvo, EVO_LOG_ERROR,
+                "Stuck layer channel 0x%08x:%d (head %u layer %u, merge "
+                "section %u, merged_head_sync %u): get %u put %u; last flip "
+                "programmed: %s, acquire %s, release %s, notifier %s",
+                pChannel->hwclass, pChannel->instance, head, layer,
+                pDispEvo->headState[head].mergeHeadSection,
+                nvkms_merged_head_sync(), get, put,
+                (pHwState->pSurfaceEvo[NVKMS_LEFT] != NULL) ? "surface" : "NULL",
+                acquire, release,
+                (pHwState->completionNotifier.surface.pSurfaceEvo != NULL) ?
+                    "yes" : "none");
+
+    /* Print the recent merged head flips once per new set of entries. */
+    if (mergedFlipTraceLogged != mergedFlipTraceCount) {
+        const NvU32 n = NV_MIN(mergedFlipTraceCount, NV_MERGED_FLIP_TRACE_LEN);
+        NvU32 i;
+
+        for (i = 0; i < n; i++) {
+            const NvU32 idx =
+                (mergedFlipTraceCount - n + i) % NV_MERGED_FLIP_TRACE_LEN;
+            char prefix[32];
+
+            nvkms_snprintf(prefix, sizeof(prefix), "  flip[-%u]", n - 1 - i);
+            LogMergedFlipTraceEntry(pDevEvo, prefix, &mergedFlipTrace[idx]);
+        }
+
+        mergedFlipTraceLogged = mergedFlipTraceCount;
+    }
+}
