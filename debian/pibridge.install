# Extra files not placed by `cmake --install` (the CMake install already stages
# the binaries, data, record layer, systemd user units, desktop entry, icons and
# docs into debian/pibridge). Only repo-side extras are listed here.

# winbridge SOURCES (OUR code, MIT/BSL): the Pimax DLLs it loads stay excluded.
# No *.exe / *.so build outputs, no ctrl-prep binary, no windata.
winbridge/*.cpp                 usr/share/pibridge/winbridge-src/
winbridge/*.h                   usr/share/pibridge/winbridge-src/
winbridge/build-winbridge.sh    usr/share/pibridge/winbridge-src/
winbridge/vit/*                 usr/share/pibridge/winbridge-src/vit/

# The `pibridge-build-winbridge` command postinst and the docs name: runs the shipped build-winbridge.sh.
debian/pibridge-build-winbridge usr/bin/

# The Crystal Super's sound rule (pro-audio profile, plain names): WirePlumber (a dependency) reads it from here for
# every user.
patches/audio/51-pimax-crystal-super.conf usr/share/wireplumber/wireplumber.conf.d/
# The patches the manual steps name (CustomHeadsetOpenVR, the NVIDIA module, the sound rule) with their README.
patches                         usr/share/pibridge/
