#!/bin/sh
# PiBridge postinst. Idempotent.
set -e

case "$1" in
    configure)
        ldconfig || true

        # Activate the udev rule. The packaged canonical copy is installed to
        # /usr/share/pibridge/udev/ by CMake; copy it into the live rules dir.
        if [ -f /usr/share/pibridge/udev/70-pibridge.rules ]; then
            cp -f /usr/share/pibridge/udev/70-pibridge.rules \
                  /lib/udev/rules.d/70-pibridge.rules
            if command -v udevadm >/dev/null 2>&1; then
                udevadm control --reload-rules || true
                udevadm trigger || true
            fi
        fi

        cat <<'EOF'

PiBridge is installed. Its user services (pibridge-keepalived, pibridge-eyed) are
enabled for every user and start at the next login; to start them now, as your user:
  systemctl --user daemon-reload && systemctl --user start pibridge-keepalived pibridge-eyed
Then launch "PiBridge" (or run `pibridge`).

Still to do by hand, once (see /usr/share/doc/pibridge/INSTALL.md, "Installing from the package"):
  - SteamVR backend: CustomHeadsetOpenVR, the headset's SteamVR display driver.
  - NVIDIA: the EDID override (/usr/share/pibridge/edid/pibridge-headset-edid).
  - Optional, inside-out on the Pimax engine: as your user
      pibridge-build-winbridge
    (needs mingw-w64; wine at run time) and the proprietary Pimax kit.

EOF
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
esac

#DEBHELPER#

exit 0
