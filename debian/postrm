#!/bin/sh
# PiBridge postrm. Reverses what postinst created (the udev rule copy); the app's
# per-user state (~/.local/share/pibridge, user services, openvrpaths) is left for
# the user to remove.
set -e

case "$1" in
    remove|purge)
        rm -f /lib/udev/rules.d/70-pibridge.rules
        if command -v udevadm >/dev/null 2>&1; then
            udevadm control --reload-rules || true
        fi
        ldconfig || true
        ;;
    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;
esac

#DEBHELPER#

exit 0
