#!/usr/bin/python3 -I
"""pibridge-headset-edid: the VR-headset EDID override for every NVIDIA output a Pimax headset shows up on.

Without the override the desktop takes the headset for a monitor (no "VR headset" flag in its EDID) and the Crystal
Super gets no picture at all (6 bpc, see make_crystal_edid.py). The override is NVIDIA's nvidia-modeset config_file:
one `override.[<GPU PCI address>].<NVKMS output>=<EDID file>` line per output, read once when the module loads, so it
takes effect at the next boot. One EDID serves every output and every Pimax: the plugged headset's own EDID with the
flag, plus the DisplayID timings of every other Pimax known (known/*.bin, and each headset seen here).

An overridden output counts as connected even with nothing plugged in, and a monitor plugged into it later would get
the headset's EDID: only outputs a Pimax was really seen on get one, and `forget` takes an output back.

  status              the Pimax outputs, one line each: <DRM connector> <NVKMS output> desktop|vr|reboot
  apply [--dry-run]   (root; the headset on) adds the outputs a Pimax shows on without the flag; rebuilds the
                      initramfs only when nvidia-modeset loads from it. Reboot afterwards
  forget <output>     (root) drops the override of an output (NVKMS name like DP-4, or DRM name like card1-DP-6)
  remove              (root) drops every override
Files: /etc/pibridge/{nvidia-modeset.conf,pimax-edid.bin}, /etc/modprobe.d/pibridge-nvidia.conf,
/etc/initramfs-tools/hooks/pibridge-edid, the headsets seen in /var/lib/pibridge/edid/. The same files under their
omarchyvr names (an install made by omarchyvr's or an older PiBridge's install-nvidia.sh) are taken over and removed.
"""
import glob
import hashlib
import os
import re
import subprocess
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)
import make_crystal_edid as mce  # noqa: E402

CONF_DIR = '/etc/pibridge'
CONF = f'{CONF_DIR}/nvidia-modeset.conf'
EDID_FILE = f'{CONF_DIR}/pimax-edid.bin'
MODPROBE = '/etc/modprobe.d/pibridge-nvidia.conf'
HOOK = '/etc/initramfs-tools/hooks/pibridge-edid'
STATE = '/var/lib/pibridge/edid'       # the headsets seen here (raw EDIDs)
PENDING = f'{STATE}/pending-reboot'    # the boot the override was written in
OLD_CONF = '/etc/omarchyvr/nvidia-modeset.conf'
OLD_FILES = ['/etc/omarchyvr/nvidia-modeset.conf', '/etc/omarchyvr/crystal-edid.bin',
             '/etc/modprobe.d/omarchyvr-nvidia.conf', '/etc/initramfs-tools/hooks/omarchyvr-edid']
DPYS = '/proc/driver/nvidia-modeset/dpys'
KNOWN = os.path.join(HERE, 'known')

HOOK_TEXT = '''#!/bin/sh
# PiBridge (pibridge-headset-edid): nvidia-modeset reads its config_file when it loads; when that is from the
# initramfs, the override has to be in there.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in prereqs) prereqs; exit 0 ;; esac
[ -f /etc/pibridge/nvidia-modeset.conf ] || exit 0
mkdir -p "$DESTDIR/etc/pibridge"
cp /etc/pibridge/nvidia-modeset.conf /etc/pibridge/pimax-edid.bin "$DESTDIR/etc/pibridge/"
'''


def read(path, mode='r'):
    try:
        with open(path, mode) as f:
            return f.read()
    except OSError:
        return b'' if 'b' in mode else ''


def boot_id():
    return read('/proc/sys/kernel/random/boot_id').strip()


def pimax_connectors():
    """[(DRM connector, GPU PCI address, its EDID)] of the connected Pimax displays on NVIDIA GPUs."""
    out = []
    for c in sorted(glob.glob('/sys/class/drm/card*-*')):
        if read(f'{c}/status').strip() != 'connected':
            continue
        edid = read(f'{c}/edid', 'rb')
        card = os.path.basename(c).split('-')[0]
        dev = os.path.realpath(f'/sys/class/drm/{card}/device')
        if not mce.is_pimax(edid) or os.path.basename(os.path.realpath(f'{dev}/driver')) != 'nvidia':
            continue
        out.append((os.path.basename(c), os.path.basename(dev), edid))
    return out


def nvkms_outputs():
    """{EDID bytes: NVKMS output name} from nvidia-modeset's own list (DRM and NVKMS number the outputs apart)."""
    found, name, hexes = {}, None, None

    def flush():
        if name and hexes:
            found[bytes.fromhex(''.join(hexes))] = name

    for line in read(DPYS).splitlines():
        m = re.match(r'\s*dpy\s*:\s*.*\((\S+)\)\s*$', line)
        if m or re.match(r'\s*(connector|deviceId)\s*:', line):
            flush()
            name, hexes = (m.group(1) if m else None), None
        elif re.match(r'\s*edid\s*:', line):
            hexes = []
        elif hexes is not None and re.fullmatch(r'\s*([0-9a-f]{2}\s*)+', line):
            hexes.append(line.replace(' ', '').strip())
        elif hexes is not None:
            flush()
            hexes = None
    flush()
    return found


def conf_ports():
    """The override keys of the current config (or of the omarchyvr-named one it replaces)."""
    out = set()
    for line in (read(CONF) or read(OLD_CONF)).splitlines():
        k, _, _ = line.partition('=')
        if k.startswith('override.'):
            out.add(k.strip())
    return out


def status():
    outputs, ports = nvkms_outputs(), conf_ports()
    pending = read(PENDING).strip() == boot_id()
    for drm, pci, edid in pimax_connectors():
        dpy = outputs.get(edid, '?')
        if mce.has_msvsdb(edid):
            state = 'vr'
        elif pending or f'override.[{pci}].{dpy}' in ports:
            state = 'reboot'
        else:
            state = 'desktop'
        print(drm, dpy, state)


def known_edids():
    out = []
    for d in (KNOWN, STATE):
        for f in sorted(glob.glob(f'{d}/*.bin')):
            e = read(f, 'rb')
            if mce.is_pimax(e) and not mce.has_msvsdb(e) and e not in out:
                out.append(e)
    return out


def initramfs_has_nvidia_modeset():
    try:
        files = subprocess.run(['lsinitramfs', f'/boot/initrd.img-{os.uname().release}'], capture_output=True,
                               text=True, check=True).stdout
    except (OSError, subprocess.CalledProcessError):
        return False
    return 'nvidia-modeset.ko' in files


def write_if_changed(path, data, mode=0o644):
    if read(path, 'rb' if isinstance(data, bytes) else 'r') == data:
        return False
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f'{path}.new'
    with open(tmp, 'wb' if isinstance(data, bytes) else 'w') as f:
        f.write(data)
    os.chmod(tmp, mode)
    os.replace(tmp, path)
    return True


def remove(path):
    if os.path.exists(path):
        os.remove(path)
        return True
    return False


def install(ports, base_edid, dry):
    """Writes the config for these override keys (none: removes it) and rebuilds the initramfs when needed."""
    # the module options besides config_file (debug=1 from install-nvidia.sh --debug) stay
    opts = (read(MODPROBE) or read('/etc/modprobe.d/omarchyvr-nvidia.conf')).split()
    opts = [o for o in opts if o not in ('options', 'nvidia-modeset') and not o.startswith('config_file=')]
    if ports:
        old = read(EDID_FILE, 'rb') or read('/etc/omarchyvr/crystal-edid.bin', 'rb')
        edid = mce.build(base_edid, [e for e in known_edids() if e != base_edid]) if base_edid is not None else old
        conf = ''.join(f'{k}={EDID_FILE}\n' for k in sorted(ports))
        opts.insert(0, f'config_file={CONF}')
    if dry:
        print('would write:', conf.rstrip('\n') if ports else '(no override)',
              f'options nvidia-modeset {" ".join(opts)}' if opts else '(no module options)', sep='\n')
        return
    changed = False
    for f in OLD_FILES:
        changed |= remove(f)
    if os.path.isdir('/etc/omarchyvr') and not os.listdir('/etc/omarchyvr'):
        os.rmdir('/etc/omarchyvr')
    if ports:
        changed |= write_if_changed(EDID_FILE, edid)
        changed |= write_if_changed(CONF, conf)
        changed |= write_if_changed(HOOK, HOOK_TEXT, 0o755)
    else:
        for f in (CONF, EDID_FILE, HOOK):
            changed |= remove(f)
    if opts:
        changed |= write_if_changed(MODPROBE, f'options nvidia-modeset {" ".join(opts)}\n')
    else:
        changed |= remove(MODPROBE)
    if not changed:
        print('nothing changed')
        return
    if initramfs_has_nvidia_modeset():
        print('nvidia-modeset loads from the initramfs: rebuilding it')
        subprocess.run(['update-initramfs', '-u', '-k', 'all'], check=True)
    write_if_changed(PENDING, boot_id() + '\n')
    print('done; reboot to use it')


def apply(dry):
    outputs, ports = nvkms_outputs(), conf_ports()
    base = None
    for drm, pci, edid in pimax_connectors():
        if mce.has_msvsdb(edid):
            print(f'{drm}: the override is in effect')
            continue
        dpy = outputs.get(edid)
        if dpy is None:
            print(f'{drm}: a Pimax headset, but nvidia-modeset does not list its output (yet)')
            continue
        print(f'{drm} (NVKMS {dpy} on {pci}): a Pimax headset shown as a monitor')
        ports.add(f'override.[{pci}].{dpy}')
        base = edid
        if not dry:
            name = f'{edid[8:12].hex()}-{hashlib.sha256(edid).hexdigest()[:12]}.bin'
            write_if_changed(f'{STATE}/{name}', edid)
    if base is None and not os.path.exists(OLD_CONF):
        print('no Pimax headset without the VR flag on an NVIDIA output (is it on?)')
        return
    install(ports, base, dry)


def forget(name):
    ports = conf_ports()
    drm_to_dpy = {drm: nvkms_outputs().get(edid) for drm, _, edid in pimax_connectors()}
    dpy = drm_to_dpy.get(name) or name
    keep = {k for k in ports if not k.endswith(f'.{dpy}')}
    if keep == ports:
        sys.exit(f'{name}: no override for it ({", ".join(sorted(ports)) or "none at all"})')
    install(keep, None, False)


def main(argv):
    cmd = argv[0] if argv else 'status'
    if cmd == 'status':
        return status()
    if os.geteuid() != 0 and '--dry-run' not in argv:
        sys.exit('run with sudo')
    if cmd == 'apply':
        return apply('--dry-run' in argv)
    if cmd == 'forget' and len(argv) == 2:
        return forget(argv[1])
    if cmd == 'remove':
        return install(set(), None, False)
    sys.exit(__doc__)


if __name__ == '__main__':
    main(sys.argv[1:])
